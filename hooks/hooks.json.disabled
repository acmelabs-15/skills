{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "if": "Edit(docs/**/*.md)|Write(docs/**/*.md)|MultiEdit(docs/**/*.md)",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-write-brain-note.ts",
            "statusMessage": "Validating Brain note write (Layer 1: local files)"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_brain_brain__edit_note|mcp__plugin_brain_brain__write_note",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-write-brain-note-mcp.ts",
            "statusMessage": "Validating Brain note write (Layer 2: MCP)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git commit *)",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-commit-validate.ts",
            "statusMessage": "Validating staged Brain notes before commit (Layer 3)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git push *)",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-push-validate.ts",
            "statusMessage": "Validating pushed commits' Brain notes (Layer 4)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(gh pr create *)",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-pr-create-validate.ts",
            "statusMessage": "Validating PR diff Brain notes (Layer 5)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-backstop.ts",
            "statusMessage": "Turn-end Brain notes validation (Layer 6: backstop)"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".git/HEAD|.git/index|.git/logs/HEAD",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-state-observer.ts",
            "statusMessage": "Post-commit graph state observation (Layer 7)"
          }
        ]
      }
    ]
  }
}
